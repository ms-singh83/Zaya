# Copy to .env.local and fill in. Never commit a filled-in file.
# docs/10-ARCHITECTURE.md §9

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Magic links (Client surface). 32+ random bytes, base64.
MAGIC_LINK_SECRET=

# Razorpay: platform-level webhook secret only.
# Per-Workspace key id and secret are stored encrypted in the database.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Email
RESEND_API_KEY=

# Background jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Safety: must stay false outside production. docs/17-DEPLOYMENT.md §3.
ALLOW_OUTBOUND_MESSAGES=false
